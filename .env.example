# Get this from MongoDB Atlas: Database > Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ferentino?retryWrites=true&w=majority

# Any long random string — used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=4000

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://localhost:5173,https://ferentino-price-analyzer.vercel.app

# Only used once, by `npm run seed`, to create the first admin login.
# Remove these two lines from .env after seeding so the password isn't left sitting around.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-before-seeding
